# Copy this file to .env and fill in the values. .env is gitignored — never commit it.
# ADK finds this file by walking up from head_hunter/, so the repo root is the right place.

# Your Google Cloud project id, e.g. head-hunter-dev. Required.
GOOGLE_CLOUD_PROJECT=

# Vertex AI region. us-central1 has the widest Gemini model availability.
GOOGLE_CLOUD_LOCATION=us-central1

# Route Gemini through Vertex AI rather than an AI Studio API key. Always TRUE here.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Who the stored profile belongs to. Single user for now; multi-user comes later.
HH_USER_ID=local

# Where the local JSON store lives, relative to the repo root. Gitignored.
HH_DATA_DIR=./data
