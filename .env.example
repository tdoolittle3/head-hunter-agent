# Copy this file to .env and fill in the values. .env is gitignored — never commit it.
# ADK finds this file by walking up from head_hunter/, so the repo root is the right place.

# Your Google Cloud project id, e.g. head-hunter-dev. Required.
GOOGLE_CLOUD_PROJECT=

# Vertex AI region. us-central1 has the widest Gemini model availability.
GOOGLE_CLOUD_LOCATION=us-central1

# Route Gemini through Vertex AI rather than an AI Studio API key. Always TRUE here.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Who the stored profile belongs to. Single user for now; multi-user comes later.
HH_USER_ID=local

# Gemini model for every agent. Default: gemini-2.5-flash, which is served in
# every project tried so far. Only set this if you get a 404 saying your
# project does not have access to that model.
# HH_MODEL=gemini-2.5-pro

# Which store the agents read and write through: json or firestore.
#
# json is the default and needs nothing but a folder, so a checkout runs with
# no Google Cloud project. Deployments set firestore, because a Cloud Run
# filesystem is wiped on every restart and the profile would not survive.
#
# Point a local run at firestore to share the deployed profile -- you need
# `gcloud auth application-default login` and access to the project.
HH_STORAGE=json

# Which Firestore database, when HH_STORAGE=firestore. `(default)` is the one a
# project gets when it has only one, which is the usual case.
# HH_FIRESTORE_DATABASE=(default)

# Where the local JSON store lives, relative to the repo root. Gitignored.
# Only used when HH_STORAGE=json.
HH_DATA_DIR=./data
